{
	"mcpServers": {
		"backgammon": {
			"command": "tools/backgammon-mcp/node_modules/.bin/tsx",
			"args": [ "tools/backgammon-mcp/server.mts" ]
		},
		"backgammon-browser": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest",
				"--cdp-endpoint",
				"http://localhost:9222"
			]
		}
	}
}
